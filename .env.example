# ---------------------------------------------------------------------------
# FundiPulse API - example environment file.
#
# COPY TO `.env` AND REPLACE EVERY PLACEHOLDER.
# NEVER COMMIT A REAL `.env` FILE. PLACEHOLDERS BELOW ARE NOT SECRETS.
#
#   cp .env.example .env
#
# Generate real secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | test | staging | production
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
# Emit newline-delimited JSON logs (recommended for production log aggregation).
LOG_JSON=true

# Comma-separated list of hostnames the API may be served from.
# Use "*" ONLY for local development; never in production.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Database --------------------------------------------------------------
# Production MUST use PostgreSQL. Never use SQLite in production.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fundipulse
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
# Applied when APP_ENV=development and you want dev seed data.
SEED_ON_STARTUP=true

# --- Secrets (REQUIRED, no usable defaults in production) -------------------
# General-purpose application signing key (invitation tokens, etc).
SECRET_KEY=replace-me-with-at-least-32-random-characters
# Dedicated key for signing access tokens (JSON Web Tokens).
JWT_SECRET=replace-me-with-a-different-32-plus-random-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=fundipulse
JWT_AUDIENCE=fundipulse-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Absolute ceiling on a refresh-token session, regardless of rotation.
REFRESH_TOKEN_ABSOLUTE_LIFETIME_DAYS=90

# --- Password hashing (Argon2id) -------------------------------------------
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# --- Password / token abuse protection -------------------------------------
# Set true to temporarily disable password policy enforcement.
# NEVER disable this in production; it exists for documented break-glass flows.
PASSWORD_POLICY_ENFORCED=true
MAX_FAILED_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# --- CORS ------------------------------------------------------------------
# Comma-separated. Empty disables the CORS middleware entirely.
# NEVER use "*" together with credentials. Production must list exact origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# --- API documentation -----------------------------------------------------
# In production this defaults to false unless explicitly enabled.
ENABLE_DOCS=true

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
# "redis" for multi-instance production deployments; set REDIS_URL when used.
# RATE_LIMIT_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_LOGIN_PER_5_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_PASSWORD_CHANGE_PER_HOUR=10
RATE_LIMIT_VERIFICATION_REQUEST_PER_DAY=20
RATE_LIMIT_FILE_UPLOAD_PER_HOUR=40
RATE_LIMIT_JOB_APPLY_PER_DAY=25
RATE_LIMIT_SEARCH_PER_MINUTE=120
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- File uploads / object storage -----------------------------------------
# "s3" for production object storage, "memory" for local development and tests.
STORAGE_BACKEND=memory
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=af-south-1
# Present only when using an S3-compatible provider that needs path-style URLs.
STORAGE_USE_PATH_STYLE=false
MAX_UPLOAD_SIZE_BYTES=10485760
SIGNED_URL_TTL_SECONDS=300
MALWARE_SCANNING_ENABLED=false

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Data retention --------------------------------------------------------
# Days an account stays deactivated before anonymisation is scheduled.
INACTIVE_ACCOUNT_PURGE_DAYS=30